# AGPL-3.0-or-later. Studio metadata; no build, install or publication by itself.
# References: the corrected installation contract of the RASGO family.
function(studio_package_policy)
    set(CPACK_PACKAGE_NAME "rasgo-synth-studio" PARENT_SCOPE)
    set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}" PARENT_SCOPE)
    set(CPACK_PACKAGE_VENDOR "RASGO" PARENT_SCOPE)
    set(CPACK_PACKAGE_CONTACT "Lucio de Araujo <rasgo.instruments@gmail.com>" PARENT_SCOPE)
    set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "RASGO generative composition instrument" PARENT_SCOPE)
    if(CMAKE_SYSTEM_NAME STREQUAL "Windows")
        if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
            message(FATAL_ERROR "Windows packages require a 64-bit native build")
        endif()
        set(platform "windows-x64")
        set(CPACK_GENERATOR "NSIS;ZIP" PARENT_SCOPE)
        set(CPACK_NSIS_PACKAGE_NAME "Rasgo Synth Studio" PARENT_SCOPE)
        set(CPACK_NSIS_DISPLAY_NAME "Rasgo Synth Studio" PARENT_SCOPE)
        set(CPACK_PACKAGE_INSTALL_DIRECTORY "Rasgo Synth Studio" PARENT_SCOPE)
        set(CPACK_PACKAGE_INSTALL_REGISTRY_KEY "Rasgo Synth Studio" PARENT_SCOPE)
        set(CPACK_NSIS_ENABLE_UNINSTALL_BEFORE_INSTALL ON PARENT_SCOPE)
        set(CPACK_NSIS_MODIFY_PATH OFF PARENT_SCOPE)
        set(CPACK_PACKAGE_EXECUTABLES "Rasgo Synth Studio;Rasgo Synth Studio" PARENT_SCOPE)
        set(CPACK_NSIS_EXECUTABLES_DIRECTORY "." PARENT_SCOPE)
        set(CPACK_CREATE_DESKTOP_LINKS "Rasgo Synth Studio" PARENT_SCOPE)
        set(CPACK_NSIS_INSTALLED_ICON_NAME "Rasgo Synth Studio.exe" PARENT_SCOPE)
        set(CPACK_NSIS_MUI_FINISHPAGE_RUN "Rasgo Synth Studio.exe" PARENT_SCOPE)
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
        if(NOT CMAKE_OSX_ARCHITECTURES)
            message(FATAL_ERROR "Select explicit macOS architectures before packaging")
        endif()
        set(architectures ${CMAKE_OSX_ARCHITECTURES})
        list(SORT architectures)
        if(architectures STREQUAL "arm64;x86_64")
            set(platform "macos-universal")
        elseif(architectures STREQUAL "arm64" OR architectures STREQUAL "x86_64")
            set(platform "macos-${architectures}")
        else()
            message(FATAL_ERROR "Unsupported macOS package architecture selection")
        endif()
        set(CPACK_GENERATOR "DragNDrop" PARENT_SCOPE)
        set(CPACK_DMG_VOLUME_NAME "Rasgo Synth Studio" PARENT_SCOPE)
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        set(platform "linux-${CMAKE_SYSTEM_PROCESSOR}")
        set(CPACK_GENERATOR "DEB" PARENT_SCOPE)
        set(CPACK_PACKAGING_INSTALL_PREFIX "/usr" PARENT_SCOPE)
        set(CPACK_DEBIAN_PACKAGE_MAINTAINER "Lucio de Araujo <rasgo.instruments@gmail.com>" PARENT_SCOPE)
        set(CPACK_DEBIAN_PACKAGE_SECTION "sound" PARENT_SCOPE)
        set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON PARENT_SCOPE)
    else()
        message(FATAL_ERROR "No Studio packaging policy for this platform")
    endif()
    set(CPACK_PACKAGE_FILE_NAME "rasgo-synth-studio-${PROJECT_VERSION}-${platform}" PARENT_SCOPE)
endfunction()
